# Copie para .env e preencha. O .env fica fora do Git.
# Gere uma senha forte local, por exemplo:
#   pwsh -c "[Convert]::ToBase64String((1..24 | % { Get-Random -Max 256 }))"
# A senha do SQL Server exige 8+ caracteres com maiuscula, minuscula, digito e simbolo.
MSSQL_SA_PASSWORD=

# Senhas das contas da demonstracao (visitante publico, organizacao e administracao).
# O infra/scripts/demo-reset.ps1 gera as tres na primeira execucao se estiverem vazias.
DEMO_VIEWER_PASSWORD=
DEMO_ORGANIZER_PASSWORD=
DEMO_ADMIN_PASSWORD=
