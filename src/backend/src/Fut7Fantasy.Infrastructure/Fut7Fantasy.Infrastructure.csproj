<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      O ASP.NET Core Identity é inseparável de HttpContext: SignInManager grava o
      cookie de sessão. A camada Infrastructure é onde a arquitetura coloca Identity,
      autenticação e observabilidade; Domain e Application seguem proibidos de
      referenciá-lo, e os testes de arquitetura verificam isso.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fut7Fantasy.Application\Fut7Fantasy.Application.csproj" />
  </ItemGroup>

</Project>
